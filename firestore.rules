rules_version = '2';

// Only cmd/server ever touches Firestore, and it does so via the Firebase
// Admin SDK on Cloud Run, which bypasses these rules entirely. This file
// exists purely as a safety net so a stray client-side Firebase SDK (web,
// mobile, or a future feature) can never read or write these documents
// directly - all access must go through the server's own auth checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
